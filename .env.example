# Copy this file to .env.local and fill it in. Without these values, the app runs on sample data.
# Find both in your Supabase project under Project Settings > API Keys.
# The publishable key is safe in the browser because row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Google Calendar sync (build step 8). Leave these empty to hide it.
# These are secrets. Never prefix them with NEXT_PUBLIC_, and never commit real values.
# Supabase: Project Settings > API Keys > Secret keys. Only server code uses it.
SUPABASE_SECRET_KEY=
# The same Google Cloud web client that Supabase uses for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes every student connect Google Calendar again.
GOOGLE_TOKEN_ENCRYPTION_KEY=
